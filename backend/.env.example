# ── PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/georisk_db

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Reddit API (get from reddit.com/prefs/apps) ─────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=GeoRiskAI/1.0 by YourUsername

# ── Twitter (ntscraper — no key needed) ─────────────────
# ntscraper scrapes without API key, no config needed

# ── HuggingFace (free — huggingface.co/settings/tokens) ─
HUGGINGFACE_API_KEY=hf_your_token_here

# ── Anthropic Claude API ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── GDELT (no key needed — free public API) ──────────────
# No configuration required

# ── App Settings ─────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── Scheduler Intervals (seconds) ────────────────────────
REDDIT_INTERVAL=1800        # 30 mins
TWITTER_INTERVAL=1800       # 30 mins
MARKET_INTERVAL=900         # 15 mins
GDELT_INTERVAL=900          # 15 mins
PROCESS_INTERVAL=3600       # 1 hour
BRIEF_INTERVAL=21600        # 6 hours
ALERT_INTERVAL=900          # 15 mins

